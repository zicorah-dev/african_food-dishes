<%- include ("partials/header"); -%>

<body class="auth-page">
  <header class="auth-header">
    <div class="container auth-nav">
      <!-- <a href="/" class="logo"> Afrika<span>Eats</span> </a> -->

      <!-- <a href="/login" class="auth-nav-link">
        Already have an account?
        <strong>Login</strong>
      </a> -->
    </div>
  </header>

  <main class="auth-main">
    <div class="auth-container">
      <div class="auth-card">
        <div class="auth-heading">
          <span class="eyebrow"> JOIN AFRIKAEATS </span>

          <h1>Create your account</h1>

          <p>Join our community and discover the flavors of Africa.</p>
        </div>

        <form class="auth-form">
          <div class="form-group">
            <h2>Sign up</h2>
            <label for="email">Email</label>
            <input type="text" name="email" required autocomplete="email" />
            <div class="email error"></div>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input
              type="password"
              name="password"
              required
              autocomplete="new-password"
            />
            <div class="password error"></div>
          </div>

          <button class="auth-submit">Sign up</button>
        </form>

        <div class="auth-divider">
          <span>or</span>
        </div>

        <p class="auth-footer-text">
          Already have an account?
          <a href="/login">Log in</a>
        </p>
      </div>

      <div class="auth-side">
        <div class="auth-side-content">
          <span class="food-icon"> 🍲 </span>
          <h2>Discover Africa <span>through food.</span></h2>
          <p>
            Explore traditional dishes, recipes and stories from across the
            continent.
          </p>
        </div>
      </div>
    </div>
  </main>
</body>

<script>
  const form = document.querySelector("form");
  const emailError = document.querySelector(".email.error");
  const passwordError = document.querySelector(".password.error");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // reset errors
    emailError.textContent = "";
    passwordError.textContent = "";

    // get the values
    const email = form.email.value;
    const password = form.password.value;

    try {
      const res = await fetch("/signup", {
        method: "POST",
        body: JSON.stringify({ email, password }),
        headers: { "content-Type": "application/json" },
      });
      const data = await res.json();
      console.log(data);
      if (data.errors) {
        emailError.textContent = data.errors.email;
        passwordError.textContent = data.errors.password;
      }
      if (data.user) {
        location.assign("africanfoods");
      }
    } catch (err) {
      console.log(err);
    }
  });
</script>

