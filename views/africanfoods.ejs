<%- include("partials/header"); -%>

<!-- Hero -->
<section class="hero" id="home">
  <div class="container hero-content">
    <div class="hero-text">
      <span class="eyebrow">AUTHENTIC • FLAVORFUL • AFRICAN</span>

      <h1>
        Taste the
        <span>Heart of Africa.</span>
      </h1>

      <p>
        Explore delicious traditional dishes, rich flavors and unforgettable
        recipes from across the African continent.
      </p>

      <div class="hero-buttons">
        <a href="dishes" class="btn btn-primary"> Explore Dishes </a>

        <a href="about" class="btn btn-secondary"> Our Story </a>
      </div>
    </div>

    <div class="hero-image">
      <div class="image-circle"></div>

      <div class="floating-card">
        <span class="card-icon">🍲</span>
        <div>
          <strong>Made with love</strong>
          <small>Traditional African flavors</small>
        </div>
      </div>
    </div>
  </div>
</section>

